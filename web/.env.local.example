# Point the UI at the API.
#
# Use 127.0.0.1, not "localhost". On macOS "localhost" resolves to both ::1 and
# 127.0.0.1, and the API binds IPv4 only, so the browser tries ::1 first and has to fail
# over -- which looks like calls that intermittently stall while curl works fine.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080


# ---------------------------------------------------------------------------
# What is deliberately NOT here
# ---------------------------------------------------------------------------
# No SMS provider credentials, of any kind.
#
# Login is this project's own OTP flow: the browser posts a phone number to
# /v1/auth/request-otp and six digits to /v1/auth/verify-otp, and that is the
# whole of its involvement. The code is generated, hashed, sent and checked on
# the server, and the httpSMS API key lives only in the API environment (.env at
# the repo root, HTTPSMS_API_KEY).
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle and is
# readable by anyone who opens the site. An SMS API key there would let any
# visitor send messages billed to this project's gateway. There is no
# NEXT_PUBLIC_HTTPSMS_* variable anywhere in this repository, and there must
# never be one.
