# API environment. Copy to `.env` (git-ignored) and adjust.
#
#   cp .env.example .env
#
# Nothing in here is read by the frontend. See docs/AUTH.md for the full notes.

# ============================================================================
# Authentication — environment
# ============================================================================
# "development" (default) or "production". Setting this to production turns on
# a set of start-up guards: the API REFUSES to boot with a development OTP
# mode, without AUTH_SECRET, or with a provider that does not actually send an
# SMS. See src/auth/config.py::_guard.
AUTH_ENV=development

# Signs session tokens and keys the OTP hashes. REQUIRED in production; a long
# random value from a secret manager. Leave unset locally and an ephemeral key
# is generated (sessions then end when the API restarts).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET=

# How long a session lasts, in seconds. Default 12 hours.
SESSION_TTL_SECONDS=43200

# ============================================================================
# Sign-in — there is nothing to configure
# ============================================================================
# There is no OTP, no password and no verification provider. A mobile number
# opens a session for that number.
#
# The number still matters: it is the account identity that owns a person's
# screening history and their Eye Health Passport, and it is the number their
# WhatsApp report is delivered to. What it no longer does is PROVE anything —
# nothing checks that the person typing it owns it. The authorisation layer is
# unchanged and still scopes every record to one account, but it is separating
# claimed identities rather than verified ones.
#
# Removed with the verification step: AUTH_PROVIDER, OTP_PROVIDER, OTP_MODE,
# TWILIO_VERIFY_SERVICE_SID, every FIREBASE_* variable and every HTTPSMS_*
# variable. TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are NOT auth variables and
# are kept below — they belong to the WhatsApp delivery provider.

# ============================================================================
# Twilio  (WhatsApp delivery provider — NOT sign-in)
# ============================================================================
# From https://console.twilio.com — see docs/TWILIO_SETUP.md for the walkthrough.
# These are SECRETS. They live only here, on the backend. They are never sent to the
# browser, never logged, and .env is git-ignored.
#
#   Account SID        Console dashboard, starts "AC"
#   Auth Token         Console dashboard, click to reveal
# These are the WhatsApp provider's credentials. Sign-in uses neither.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
#
TWILIO_TIMEOUT_SECONDS=10

# ============================================================================
# WhatsApp report delivery  (CareBridge — optional channel)
# ============================================================================
# Delivers the ALREADY-GENERATED screening PDF to the patient's own registered
# mobile number. It is a communication layer: it cannot change a grade, a referral
# or anything else clinical. See docs/WHATSAPP.md for the Twilio walkthrough.
#
# IMPORTANT: Twilio Verify (above) and Twilio WhatsApp are SEPARATE capabilities.
# Working OTP tells you nothing about whether WhatsApp will send. They share an
# account — the same TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN — and nothing else.

# "live" -> a real Twilio WhatsApp call is made
# "disabled" -> no call is made and the UI says delivery is unavailable
# There is deliberately no mode that reports a fake success.
WHATSAPP_MODE=live
WHATSAPP_ENABLED=1

# ---------------------------------------------------------------- provider
# Which vendor actually carries the message: "meta" or "twilio".
#
# This is the ONLY switch. There is deliberately no second META_WHATSAPP_ENABLED /
# TWILIO_WHATSAPP_ENABLED pair — two flags that can contradict each other
# ("provider=meta, meta_enabled=false") is a configuration bug with no obvious
# winner. One variable, one meaning.
#
# Which one to pick:
#   meta    sends PDFs on a FREE tier. Use this for the SIH demo.
#   twilio  needs a PAID account: a Twilio trial refuses MediaUrl outright
#           (error code 0) and cannot send a PDF by any parameter combination.
#
# Both implementations are kept and fully tested; switching is this line only.
WHATSAPP_PROVIDER=meta

# ---------------------------------------------- Meta WhatsApp Cloud API (default)
# From Meta App Dashboard -> WhatsApp -> API Setup. See docs/WHATSAPP.md.
#
# The numeric "Phone number ID" — NOT the phone number itself. Pasting the number
# here is the commonest setup mistake, so the API refuses it by name at startup
# rather than letting Graph answer with something that points nowhere near it.
# META_WHATSAPP_PHONE_NUMBER_ID=123456789012345
#
# A temporary token from that screen lasts 24 HOURS — long enough to work in
# rehearsal and fail during the demo. Generate a permanent System User token before
# presenting (docs/WHATSAPP.md).
# META_WHATSAPP_ACCESS_TOKEN=
#
# Not needed to send; kept because the console shows it beside the number id and
# the two are easy to confuse.
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------- Twilio
# The WhatsApp sender, in E.164. The "whatsapp:" prefix is optional; it is added
# if absent. Every recipient must have joined your sandbox first (docs/WHATSAPP.md).
#
# Do NOT assume +14155238886. Twilio's "Try out WhatsApp" onboarding assigns a
# sender per account, so read yours off the Twilio Console (Messaging -> Try it out
# -> WhatsApp) — it is the number your phone sent its "join" message TO.
# TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# Where the PROVIDER can reach THIS API from the public internet. Required by both
# Meta and Twilio.
#
# Neither vendor accepts a file upload — each fetches the media itself, from its own
# network. A localhost URL therefore cannot work, and the API refuses to try rather
# than producing an opaque provider error (Meta would say "media download error"
# 131052, which points nowhere near the real cause):
#
#   local dev   scripts/dev_tunnel.sh   (starts a Cloudflare quick tunnel and
#                                       writes the https URL here for you)
#   deployed    the Cloud Run / Render URL
# PUBLIC_BASE_URL=

# How long one signed media URL stays valid. Twilio fetches within seconds; this is
# slack for a retry, not a browsing window.
REPORT_MEDIA_TTL_SECONDS=900

# Keep the exact PDF the pipeline already produced so it can be delivered later
# WITHOUT being generated a second time. Set to 0 to retain nothing; the WhatsApp
# endpoint then has nothing to send and says so.
STORE_REPORT_PDF=1
# REPORT_MEDIA_DIR=data/interim/report_media

# Duplicate protection. A second request for the same report inside this window
# returns the first delivery instead of sending again.
WHATSAPP_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_TIMEOUT_SECONDS=15

# ============================================================================
# Smart Care Finder  (Google Places API (New))
# ============================================================================
# "From screening to the next step of care": the result page can find real
# eye-care facilities near the patient and hand them directions. Optional — with
# nothing set here the feature reports "not available right now", and the result,
# the explanation and the report are completely unaffected.
#
# Full setup, including what to restrict the key to: docs/CARE_FINDER.md
# Verify a key without opening a browser:  make care-finder-check
#
# ---------------------------------------------------------------- the key
# A SERVER-SIDE Google Cloud API key. This is a secret. It is read only by
# src/carefinder/, it is sent to Google in a request header, and it is never
# returned by any endpoint, never logged and never exposed to the browser —
# there is deliberately no NEXT_PUBLIC_GOOGLE_* variable anywhere in this repo.
#
# In the Google Cloud console the project needs:
#   * the "Places API (New)" enabled      (NOT "Places API", the legacy one)
#   * billing enabled on the project      (Places has no free-key tier)
#   * this key restricted to: API restrictions -> Places API (New)
#     and NO HTTP-referrer restriction, because this is a server-to-server call
#     — a referrer-restricted key answers 403 "API keys with referer
#     restrictions cannot be used with this API".
# GOOGLE_MAPS_API_KEY=

# Off => the endpoint answers "not configured" and the UI hides the search.
CARE_FINDER_ENABLED=1

# ---------------------------------------------------------------- the search
# The eye-care query sent to Places Text Search (New). A text query rather than a
# Nearby Search type filter because the Places (New) type table has no
# "ophthalmologist" and no eye-specific type at all — see src/carefinder/config.py.
# CARE_FINDER_QUERY=eye hospital ophthalmologist eye clinic eye care

# Biases Google's ranking and address formatting. Two-letter CLDR region code.
CARE_FINDER_REGION_CODE=IN

# Radius. The default is the first search; the maximum is the ceiling the
# "search within 25 km" button can reach. Anything a client asks for is clamped
# into this range server-side. Google's own hard limit is 50000.
CARE_FINDER_DEFAULT_RADIUS_M=5000
CARE_FINDER_MIN_RADIUS_M=500
CARE_FINDER_MAX_RADIUS_M=25000

# Google's page-size ceiling is 20 for both Places (New) search methods.
CARE_FINDER_MAX_RESULTS=20

# ---------------------------------------------------------------- spend control
# Identical search, same account, inside this window -> served from memory with
# no Google call. This is what makes the radius buttons and a double tap free.
CARE_FINDER_CACHE_TTL_SECONDS=300

# Per account, per rolling window. A patient needs a handful of searches; past
# that it is a loop or an abuse, and neither should reach a billed API.
CARE_FINDER_RATE_LIMIT=30
CARE_FINDER_RATE_WINDOW_SECONDS=3600
CARE_FINDER_TIMEOUT_SECONDS=10

# The rating, the review count, the phone number, the website and the open/closed
# badge are Enterprise-SKU Places fields and cost more per call. Set to 0 for a
# materially cheaper Pro-SKU search; the facility cards then simply stop showing
# what they were not given, rather than inventing it.
CARE_FINDER_RICH_FIELDS=1

# ============================================================================
# Authorisation
# ============================================================================
# Comma-separated mobiles provisioned as admin (the doctor-verification
# authority) the first time they sign in. This is the bootstrap for "somebody
# has to approve the first doctor". It is an operator-controlled allow-list; a
# person signing up cannot influence it.
# ADMIN_MOBILES=+919876500000

# Require a session for POST /v1/analyze, GET /v1/scans and POST /v1/review.
# On by default. Turn it off ONLY for an offline pipeline benchmark with no
# user-facing service exposed.
AUTH_PROTECT_ANALYZE=1

# ============================================================================
# Storage
# ============================================================================
# Accounts, OTP challenges and revoked sessions. Kept in files of their own —
# account data and medical scan data never share a record.
# AUTH_STORE_DIR=data/interim/auth

# Full per-scan evidence (images, Grad-CAM, rule detail) so a verified doctor
# can reopen a report. Set to 0 to keep nothing but the scan summary; the
# doctor detail view then shows the numbers without the images.
STORE_SCAN_EVIDENCE=1
# SCAN_EVIDENCE_DIR=data/interim/scan_evidence

# ============================================================================
# CareBridge Eye Health Passport (longitudinal tracking)
# ============================================================================
# One patient, many screenings, over years: the record that lets a returning
# patient's new result be compared with their previous one, and that carries the
# follow-up plan between visits. Full notes: docs/PASSPORT.md
#
# It does NOT touch the model. Nothing in src/passport/ loads a weight, reads a
# pixel or evaluates a threshold; it subtracts two grades the model already
# decided and names the difference.

# Set to 0 to switch longitudinal tracking off entirely. /v1/analyze then stops
# recording history and the passport endpoints answer honestly that there is none.
PASSPORT_ENABLED=1
# PASSPORT_STORE_DIR=data/interim/passport

# Bound on one patient's timeline. A limit, not a policy — the comparison only
# ever needs the most recent entries.
# PASSPORT_MAX_HISTORY=200

# Duplicate protection for the comparison send, mirroring WHATSAPP_RESEND_COOLDOWN_SECONDS.
# Separate variable because a patient may legitimately want the comparison
# seconds after the report itself.
# PASSPORT_RESEND_COOLDOWN_SECONDS=60

# ============================================================================
# Existing settings (unchanged)
# ============================================================================
# CORS_ORIGINS=http://localhost:3000
# USE_FIRESTORE=0
# LOCAL_STORE_PATH=data/interim/scans.json
# DR_MODEL_DIR=artifacts/model
